# ----- Core -----
APP_NAME=DocIntel AI Platform
API_V1_PREFIX=/api/v1
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me
LOG_LEVEL=INFO
LOG_JSON=false

# ----- Storage -----
DATABASE_URL=sqlite:///./data/docintel.db
UPLOAD_DIR=./data/uploads
MODEL_DIR=./data/models
INDEX_DIR=./data/index
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- Decisioning thresholds -----
AUTO_APPROVE_THRESHOLD=0.92
HUMAN_REVIEW_THRESHOLD=0.70
ANOMALY_REVIEW_THRESHOLD=0.25
ANOMALY_HIGH_PRIORITY_THRESHOLD=0.5

# ----- Embeddings (auto = neural if available, else deterministic hashing) -----
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HASHING_EMBEDDING_DIM=384

# ----- Inference device (GPU acceleration when available) -----
INFERENCE_DEVICE=auto
INFERENCE_FP16=true

# ----- Vector store (auto = Qdrant if reachable, else local numpy) -----
VECTOR_BACKEND=auto
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=docintel_chunks

# ----- Hybrid retrieval -----
DENSE_TOP_K=30
SPARSE_TOP_K=30
RRF_K=60
BM25_K1=1.5
BM25_B=0.75

# ----- Cross-encoder reranking -----
ENABLE_RERANKER=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ----- OCR (needs tesseract-ocr + poppler-utils system packages) -----
OCR_ENABLED=true
OCR_LANGUAGES=eng

# ----- Authentication / multi-tenancy -----
ENABLE_AUTH=false
DEFAULT_TENANT=default
# comma-separated "apikey:tenant" pairs, e.g. keyA:acme,keyB:globex
AUTH_API_KEYS=
JWT_SECRET=change-me-jwt
JWT_ALGORITHM=HS256

# ----- Ingestion mode / Kafka event streaming -----
INGESTION_MODE=inproc          # inproc | kafka
ENABLE_KAFKA=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=docintel
KAFKA_CONSUMER_GROUP=docintel-workers

# ----- Observability -----
ENABLE_PROMETHEUS=true
ENABLE_OTEL=false
OTEL_SERVICE_NAME=docintel-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ----- Experiment tracking -----
ENABLE_MLFLOW=false
MLFLOW_TRACKING_URI=http://localhost:5001
MLFLOW_EXPERIMENT=docintel

# ----- Layout-aware OCR (Donut / LayoutLM; needs transformers + a checkpoint) -----
ENABLE_LAYOUT_OCR=false
LAYOUT_MODEL=naver-clova-ix/donut-base

# ----- Vector store scale / per-tenant -----
QDRANT_PER_TENANT=true
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100
QDRANT_QUANTIZATION=none           # none | scalar

# ----- MLflow model registry + CI quality gates -----
MLFLOW_REGISTER_MODELS=false
CLASSIFIER_ACCURACY_GATE=0.85
CLASSIFIER_MACRO_F1_GATE=0.85

# ----- Drift monitoring (PSI thresholds) -----
DRIFT_PSI_WARN=0.1
DRIFT_PSI_ALERT=0.25
